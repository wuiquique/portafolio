---
import { Image } from "astro:assets";
import Beat from "../assets/mockups/Beat.webp";
import Cami from "../assets/mockups/Cami.webp";
import SMID from "../assets/mockups/SMID.webp";
import Spotify from "../assets/mockups/Spotify.webp";
import Todo from "../assets/mockups/Todo.webp";
import Badge from "./Badge.astro";

const {
  title,
  description,
  image,
  link,
  front,
  back,
  skills,
  nda = false,
  codeNda = false,
  isApp = false,
} = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-16">
  <div>
    <Image
      src={image === 1
        ? Beat
        : image === 2
          ? Cami
          : image === 3
            ? SMID
            : image === 4
              ? Spotify
              : Todo}
      alt="Project image"
      class="w-[600px]"
    />
  </div>
  <div class="-mt-20 md:mt-20">
    <h3
      class="text-light-titles dark:text-dark-titles font-titles text-lg font-semibold text-start"
    >
      {title}
    </h3>
    <p class="text-light-texts dark:text-dark-texts font-texts">
      {description}
    </p>
    <div class="hidden md:flex flex-wrap gap-4 my-4">
      {skills.map((item) => <Badge>{item}</Badge>)}
    </div>
    <div class="mt-4">
      {
        link && (
          <div>
            <h5 class="mb-4 text-light-titles dark:text-dark-titles font-titles font-semibold text-sm">
              Explore the Project
            </h5>
            <a
              class="bg-light-primary dark:bg-dark-primary py-3 px-8 rounded-lg text-dark-titles text-sm font-titles font-semibold hover:-translate-y-1 transition-all duration-300"
              href={link}
            >
              Project link
            </a>
          </div>
        )
      }
      {
        (front || back || codeNda) && (
          <div>
            <h5 class="mt-4 mb-2 text-light-titles dark:text-dark-titles font-titles font-semibold text-sm">
              Source code
            </h5>
            <div class="flex gap-6">
              {front && (
                <a
                  class="bg-light-secondary dark:bg-dark-secondary py-3 px-8 rounded-lg text-dark-titles text-sm font-titles font-semibold hover:-translate-y-1 transition-all duration-300"
                  href={front}
                >
                  {isApp ? "App Interface" : "Front-End"}
                </a>
              )}
              {back && (
                <a
                  class="bg-light-secondary dark:bg-dark-secondary py-3 px-8 rounded-lg text-dark-titles text-sm font-titles font-semibold hover:-translate-y-1 transition-all duration-300"
                  href={back}
                >
                  Back-End
                </a>
              )}
              {codeNda && (
                <a class="bg-zinc-500 dark:bg-zinc-700 py-3 px-8 rounded-lg text-dark-titles text-sm font-titles font-semibold">
                  NDA Protected
                </a>
              )}
            </div>
          </div>
        )
      }
      {
        nda && (
          <div>
            <h5 class="mb-4 text-light-titles dark:text-dark-titles font-titles font-semibold text-sm">
              Explore the Project
            </h5>
            <a class="bg-zinc-500 dark:bg-zinc-700 py-3 px-8 rounded-lg text-dark-titles text-sm font-titles font-semibold">
              NDA Protected
            </a>
          </div>
        )
      }
    </div>
  </div>
</div>
