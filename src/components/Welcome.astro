---
import { Image } from "astro:assets";
import PixelImage from "../assets/pxl2.png";
---

<div class="flex flex-col items-center mt-10 md:mt-32 z-50">
    <h1
      class="text-light-titles dark:text-dark-titles font-titles text-2xl font-bold text-center"
    >
      Luis Enrique Menéndez Figueroa
    </h1>
    <h4
      class="text-light-texts dark:text-dark-texts font-texts text-lg font-semibold w-72 md:w-96 text-center"
    >
      Systems and Computer Science Engineer / iOS Developer / Full Stack
      Developer / Front End Focused / UX UI
    </h4>
    <Image
      src={PixelImage}
      alt="Me as a Pixel Art :)"
      class="rounded-full w-52 md:w-80 mt-8"
    />
    <div class="mt-8 md:mt-20 animate-bounce">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-light-titles dark:text-dark-titles"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </div>
